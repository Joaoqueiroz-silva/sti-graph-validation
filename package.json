{
  "name": "sti-graph-validation",
  "version": "0.5.0",
  "description": "Dados, código e resultados do artigo Agentic Intelligent Tutoring Systems (v0.5): validação de grafos de comportamento gerados por agentes de IA contra grafos de especialistas do CTAT.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joaoqueiroz-silva/sti-graph-validation.git"
  },
  "homepage": "https://github.com/Joaoqueiroz-silva/sti-graph-validation#readme",
  "bugs": {
    "url": "https://github.com/Joaoqueiroz-silva/sti-graph-validation/issues"
  },
  "scripts": {
    "test": "vitest run",
    "links:check": "node scripts/check-local-links.mjs",
    "results:verify": "node scripts/verify-derived-results.mjs",
    "mirror:verify": "node scripts/espelhar-producao.mjs --verify",
    "artifacts:check": "node scripts/check-public-artifacts.mjs",
    "manifest:verify": "node scripts/verify-current-manifest.mjs",
    "manifest:write": "node scripts/verify-current-manifest.mjs --write",
    "verify:offline": "npm test && npm run links:check && npm run results:verify && npm run mirror:verify && npm run artifacts:check && npm run manifest:verify",
    "reproduce:collect": "node -r dotenv/config scripts/reproduce-collect.mjs",
    "c3:reanalyze": "node analysis/reanalyze-c3.mjs",
    "materialize": "node materialize-dataset.mjs cases/ctat-6.17 --name frac-numberline-6.17",
    "fixtures:production": "node production-fidelity/build-ctat-fixtures.mjs",
    "preflight:production": "node production-fidelity/run-fixture-preflight.mjs"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "vitest": "^3.2.6",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
